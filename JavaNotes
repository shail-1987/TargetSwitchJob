// Print 1-10 (The condition is checked before executing the loop body. )
	public static void printUsingWhile() {
		int i = 1;

		while (i <= 10) {
			System.out.println(i);
			i++;
		}

	}
	
// print 1-10 using While-DO (The loop body is executed at least once, and then the condition is checked.)
	
	public static void printUsingWhileDo() {
		int i=1;
		do{
			System.out.println(i);i++;
		}while(i<=10);
	}
	
